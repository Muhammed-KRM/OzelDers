@page "/admin"
@page "/admin/dashboard"
@using OzelDers.Business.DTOs
@using OzelDers.Business.Interfaces
@inject HttpClient Http
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin Paneli - OzelDers</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <PageHeader Title="Admin Paneli" 
                       Subtitle="Sistem yönetimi ve istatistikler" />
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            @for (int i = 0; i < 4; i++)
            {
                <div class="col-md-3 mb-4">
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton" style="height: 60px;"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (stats != null)
    {
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="card bg-primary text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@stats.TotalUsers</h4>
                                <p class="mb-0">Toplam Kullanıcı</p>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-users fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card bg-success text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@stats.TotalListings</h4>
                                <p class="mb-0">Toplam İlan</p>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-list fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card bg-info text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">@stats.TotalMessages</h4>
                                <p class="mb-0">Toplam Mesaj</p>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-comments fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="card bg-warning text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <div>
                                <h4 class="mb-0">₺@stats.TotalRevenue.ToString("N0")</h4>
                                <p class="mb-0">Toplam Gelir</p>
                            </div>
                            <div class="align-self-center">
                                <i class="fas fa-money-bill-wave fa-2x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Hızlı İşlemler</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="/admin/users" class="btn btn-outline-primary">
                                <i class="fas fa-users me-2"></i>Kullanıcı Yönetimi
                            </a>
                            <a href="/admin/listings" class="btn btn-outline-success">
                                <i class="fas fa-list me-2"></i>İlan Yönetimi
                            </a>
                            <a href="/admin/violations" class="btn btn-outline-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>İhlal Yönetimi
                            </a>
                            <a href="/admin/settings" class="btn btn-outline-info">
                                <i class="fas fa-cog me-2"></i>Sistem Ayarları
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">SMS Test</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Telefon Numarası</label>
                            <input type="text" class="form-control" @bind="smsPhone" placeholder="05321234567" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mesaj</label>
                            <textarea class="form-control" @bind="smsMessage" rows="3" placeholder="Test mesajı..."></textarea>
                        </div>
                        <button class="btn btn-primary" @onclick="SendTestSms" disabled="@isSendingSms">
                            @if (isSendingSms)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            SMS Gönder
                        </button>
                        @if (!string.IsNullOrEmpty(smsResult))
                        {
                            <div class="alert @(smsSuccess ? "alert-success" : "alert-danger") mt-3">
                                @smsResult
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">FCM Push Notification Test</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">FCM Token</label>
                            <input type="text" class="form-control" @bind="fcmToken" placeholder="Firebase token..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Başlık</label>
                            <input type="text" class="form-control" @bind="fcmTitle" placeholder="Bildirim başlığı" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mesaj</label>
                            <textarea class="form-control" @bind="fcmBody" rows="2" placeholder="Bildirim mesajı..."></textarea>
                        </div>
                        <button class="btn btn-success" @onclick="SendTestFcm" disabled="@isSendingFcm">
                            @if (isSendingFcm)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            FCM Gönder
                        </button>
                        @if (!string.IsNullOrEmpty(fcmResult))
                        {
                            <div class="alert @(fcmSuccess ? "alert-success" : "alert-danger") mt-3">
                                @fcmResult
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AdminDashboardDto? stats;
    private bool isLoading = true;
    
    private string smsPhone = "";
    private string smsMessage = "OzelDers test mesajı";
    private bool isSendingSms = false;
    private string smsResult = "";
    private bool smsSuccess = false;

    private string fcmToken = "";
    private string fcmTitle = "OzelDers Test";
    private string fcmBody = "Bu bir test bildirimidir";
    private bool isSendingFcm = false;
    private string fcmResult = "";
    private bool fcmSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        try
        {
            isLoading = true;
            stats = await Http.GetFromJsonAsync<AdminDashboardDto>("api/admin/dashboard");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Dashboard yüklenirken hata: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SendTestSms()
    {
        if (string.IsNullOrWhiteSpace(smsPhone) || string.IsNullOrWhiteSpace(smsMessage))
        {
            smsResult = "Telefon numarası ve mesaj gerekli.";
            smsSuccess = false;
            return;
        }

        try
        {
            isSendingSms = true;
            smsResult = "";

            var response = await Http.PostAsJsonAsync("api/admin/test-sms", new
            {
                PhoneNumber = smsPhone,
                Message = smsMessage
            });

            if (response.IsSuccessStatusCode)
            {
                smsResult = "SMS başarıyla gönderildi!";
                smsSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                smsResult = $"SMS gönderimi başarısız: {error}";
                smsSuccess = false;
            }
        }
        catch (Exception ex)
        {
            smsResult = $"Hata: {ex.Message}";
            smsSuccess = false;
        }
        finally
        {
            isSendingSms = false;
        }
    }

    private async Task SendTestFcm()
    {
        if (string.IsNullOrWhiteSpace(fcmToken) || string.IsNullOrWhiteSpace(fcmTitle) || string.IsNullOrWhiteSpace(fcmBody))
        {
            fcmResult = "FCM token, başlık ve mesaj gerekli.";
            fcmSuccess = false;
            return;
        }

        try
        {
            isSendingFcm = true;
            fcmResult = "";

            var response = await Http.PostAsJsonAsync("api/admin/test-fcm", new
            {
                Token = fcmToken,
                Title = fcmTitle,
                Body = fcmBody
            });

            if (response.IsSuccessStatusCode)
            {
                fcmResult = "FCM bildirimi başarıyla gönderildi!";
                fcmSuccess = true;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                fcmResult = $"FCM gönderimi başarısız: {error}";
                fcmSuccess = false;
            }
        }
        catch (Exception ex)
        {
            fcmResult = $"Hata: {ex.Message}";
            fcmSuccess = false;
        }
        finally
        {
            isSendingFcm = false;
        }
    }
}